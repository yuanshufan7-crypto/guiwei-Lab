# 归位 Lab · 视觉识别配置（服务端专用）
# 使用方式：把本文件复制为 .env（同目录），填入你的服务信息，然后重启 npm start。
# .env 已被 .gitignore 忽略，真实密钥不会进入仓库、前端构建、截图或接口响应。
#
# 未配置时：POST /api/recognize 返回 mode="unavailable"，界面会明确显示“服务端未配置真实识别服务”，
# 仍可人工核对；也可以使用界面中明确标注的“演示结果”，演示结果不会被当作识别成功。
#
# 本仓库不预设任何服务端点或模型名称。地址与模型名请以你所选多模态服务的官方文档为准。

# 服务协议类型。当前支持：openai-compatible
# 适用于任何提供 OpenAI 兼容 /chat/completions 接口、且模型支持图片输入的多模态服务。
LAB_VISION_PROVIDER=openai-compatible

# 服务基础地址（不要包含 /chat/completions 部分）
# 例如官方文档给出的完整地址是 https://<你的服务域名>/v1/chat/completions，这里就填写 https://<你的服务域名>/v1
LAB_VISION_BASE_URL=

# 支持图片输入的模型名称（填写官方文档中的实际名称）
LAB_VISION_MODEL=

# 调用密钥。只在服务端读取，代码不会把它写入日志、接口响应或前端产物。
LAB_VISION_API_KEY=

# 可选：接口路径，默认 /chat/completions
LAB_VISION_CHAT_PATH=/chat/completions

# 可选：请求超时（毫秒），默认 30000，允许范围 1000—120000。超时后接口返回“识别不可用”，不影响人工登记与核验。
LAB_VISION_TIMEOUT_MS=30000

# 可选：要求服务返回严格 JSON 对象（服务支持时开启，默认关闭）
# LAB_VISION_JSON_MODE=1

# 可选：设为 0 时彻底关闭界面中的“演示结果”入口，只允许真实识别
# LAB_VISION_ALLOW_DEMO=0